---
import ThemeToggleButton from './ThemeToggleButton.astro';
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
	{ label: 'Home', href: base, key: '' },
	{ label: 'Work', href: `${base}work/`, key: 'work' },
	{ label: 'Publications', href: `${base}publications/`, key: 'publications' },
	{ label: 'About', href: `${base}about/`, key: 'about' },
	{ label: 'News', href: `${base}news/`, key: 'news' },
];
---

<nav>
	<a class="brand" href={base} aria-label="Sharun Kuhar — home">
		<svg class="mark" viewBox="0 0 40 40" fill="none" stroke-width="2.2" aria-hidden="true">
			<path d="M4 26 C 12 26, 12 14, 20 14 S 28 26, 36 26" stroke="var(--flow)" stroke-linecap="round"></path>
			<path d="M4 20 C 12 20, 12 8, 20 8 S 28 20, 36 20" stroke="var(--ember)" stroke-opacity=".85" stroke-linecap="round"></path>
			<path d="M4 32 C 12 32, 12 20, 20 20 S 28 32, 36 32" stroke="var(--flow)" stroke-opacity=".5" stroke-linecap="round"></path>
		</svg>
		<span class="wordmark">Sharun Kuhar</span>
	</a>

	<div class="links">
		{links.map((l) => (
			<a class={`link${current === l.key ? ' active' : ''}`} href={l.href}>{l.label}</a>
		))}
	</div>

	<div class="tail">
		<ThemeToggleButton />
		<a class={`cta${current === 'contact' ? ' active' : ''}`} href={`${base}contact/`}>Contact</a>
	</div>
</nav>

<style>
	nav {
		display: flex;
		align-items: center;
		gap: var(--sp-5);
		height: 68px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 11px;
		margin-right: auto;
		color: var(--ink);
		text-decoration: none;
		font-family: var(--font-text);
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.mark {
		width: 26px;
		height: 26px;
		flex: 0 0 auto;
	}

	.links {
		display: flex;
		align-items: center;
		gap: var(--sp-5);
	}

	.link {
		font-family: var(--font-text);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		padding: 6px 2px;
		position: relative;
		transition: color 0.15s ease;
	}

	.link:hover,
	.link.active {
		color: var(--ink);
	}

	.link.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		background: var(--flow);
	}

	.tail {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
	}

	.cta {
		font-family: var(--font-text);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--flow);
		text-decoration: none;
		border: 1px solid var(--flow);
		padding: 8px 16px;
		border-radius: var(--radius-sm);
		transition:
			background-color 0.18s ease,
			color 0.18s ease;
	}

	.cta:hover,
	.cta.active {
		background: var(--flow);
		color: #fff;
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			height: auto;
			padding: 12px 0;
			gap: var(--sp-3) var(--sp-4);
		}
		.brand {
			margin-right: auto;
		}
		.links {
			order: 3;
			width: 100%;
			gap: var(--sp-4);
			flex-wrap: wrap;
		}
	}

	@media (max-width: 400px) {
		.wordmark {
			display: none;
		}
	}
</style>
