---
const year = new Date().getFullYear();
---

<footer>
	<div class="bar">
		<span>&copy; {year} Sharun Kuhar</span>
		<span class="meta">Computational physics of the human body</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		margin-top: var(--sp-9);
	}

	.bar {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: var(--sp-6);
		width: 100%;
		box-sizing: border-box;
		display: flex;
		justify-content: space-between;
		gap: var(--sp-4);
		font-family: var(--font-text);
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--muted);
	}

	.meta {
		font-style: italic;
		font-family: var(--font-display);
		font-weight: 400;
	}

	@media (max-width: 560px) {
		.bar {
			flex-direction: column;
			gap: var(--sp-2);
			text-align: center;
		}
	}
</style>
