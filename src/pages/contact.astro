---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact — Sharun Kuhar"
	description="Contact Sharun Kuhar — email, LinkedIn, Google Scholar, ORCiD"
	permalink="contact"
	current="contact"
>
	<div class="contact-page">
		<h2>Contact</h2>
		<p class="intro">The best ways to reach me or find my work online.</p>

		<div class="contact-list">

			<a href="mailto:kuhars@purdue.edu" class="contact-item">
				<div class="contact-icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="4" width="20" height="16" rx="2"/>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
					</svg>
				</div>
				<div class="contact-body">
					<span class="contact-label">Email</span>
					<span class="contact-value">kuhars@purdue.edu</span>
				</div>
				<div class="contact-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</a>

			<a href="https://www.linkedin.com/in/sharunkuhar" target="_blank" rel="noopener noreferrer" class="contact-item">
				<div class="contact-icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</div>
				<div class="contact-body">
					<span class="contact-label">LinkedIn</span>
					<span class="contact-value">linkedin.com/in/sharunkuhar</span>
				</div>
				<div class="contact-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</a>

			<a href="https://scholar.google.com/citations?user=qHP7cqgAAAAJ" target="_blank" rel="noopener noreferrer" class="contact-item">
				<div class="contact-icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/>
					</svg>
				</div>
				<div class="contact-body">
					<span class="contact-label">Google Scholar</span>
					<span class="contact-value">scholar.google.com</span>
				</div>
				<div class="contact-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</a>

			<a href="https://orcid.org/0000-0001-9612-7994" target="_blank" rel="noopener noreferrer" class="contact-item">
				<div class="contact-icon orcid-icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
						<path d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z"/>
						<path fill="var(--background-body)" d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-20.8 53.6-56.7 53.6h-41.9V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7C191.7 111.2 178 93 148 93h-23.7v79.4zM88.7 56.8c0 5.5-4.5 10.1-10.1 10.1s-10.1-4.6-10.1-10.1c0-5.6 4.5-10.1 10.1-10.1s10.1 4.5 10.1 10.1z"/>
					</svg>
				</div>
				<div class="contact-body">
					<span class="contact-label">ORCiD</span>
					<span class="contact-value">0000-0001-9612-7994</span>
				</div>
				<div class="contact-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</a>

		</div>
	</div>
</BaseLayout>

<style>
	.contact-page {
		max-width: 600px;
		padding: 2em 0 4em;
	}

	h2 {
		margin-top: 0;
	}

	.intro {
		color: var(--text-secondary);
		font-size: 1.1rem;
		margin: 0 0 2.5em;
	}

	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 0;
		border-top: 1px solid color-mix(in srgb, var(--text-secondary) 25%, transparent);
	}

	.contact-item {
		display: flex;
		align-items: center;
		gap: 1.25em;
		padding: 1.25em 0.5em;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid color-mix(in srgb, var(--text-secondary) 25%, transparent);
		transition: background-color 0.15s ease, padding-left 0.2s ease;
		border-radius: 4px;
	}

	.contact-item:hover {
		background-color: color-mix(in srgb, var(--primary-color) 8%, transparent);
		padding-left: 1em;
	}

	/* override the global p a box-shadow rule */
	.contact-item:hover {
		box-shadow: none;
		color: inherit;
	}

	.contact-icon {
		flex-shrink: 0;
		width: 42px;
		height: 42px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background-color: color-mix(in srgb, var(--primary-color) 12%, transparent);
		color: var(--primary-color);
	}

	.contact-icon svg {
		width: 20px;
		height: 20px;
	}

	.orcid-icon {
		background-color: transparent;
		color: #a6ce39;
	}

	.contact-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}

	.contact-label {
		font-family: var(--font-family-sans);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-secondary);
	}

	.contact-value {
		font-family: var(--font-family-sans);
		font-size: 1rem;
		color: var(--text-main);
	}

	.contact-arrow {
		flex-shrink: 0;
		color: var(--text-secondary);
		opacity: 0;
		transition: opacity 0.15s ease, transform 0.2s ease;
	}

	.contact-arrow svg {
		width: 18px;
		height: 18px;
	}

	.contact-item:hover .contact-arrow {
		opacity: 1;
		transform: translateX(3px);
	}

	@media (max-width: 520px) {
		.contact-page {
			padding: 1em 0 3em;
		}
	}
</style>