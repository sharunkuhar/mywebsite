	{ id: 'preprints', label: 'Preprints', items: preprints, kind: 'paper' },
	{ id: 'journal', label: 'Journal Papers', items: journalPapers, kind: 'paper' },
	{ id: 'conferences', label: 'Conference Presentations', items: conferences, kind: 'conf' },
	{ id: 'patents', label: 'Patents', items: patents, kind: 'patent' },
];

// Bold the site owner's name in each author list.
const authorsHtml = (a: string) => a.replace('S. Kuhar', '<b>S. Kuhar</b>');
---

<BaseLayout title={title} description={description} permalink={permalink} current="publications">
	<h1>Publications</h1>
	<p>
		{
			sections.map((s, i) => (
				<>
					{i > 0 && ' · '}
					<a href={`#${s.id}`}>{s.label}</a>
				</>
			))
		}
	</p>

	{
		sections.map((s) => (
			<section id={s.id}>
				<h2>{s.label}</h2>
				{s.items.map((p) => (
					<p>
						{p.link ? <a href={p.link}>{p.title}</a> : p.title}
						<br />
						<span set:html={authorsHtml(p.authors)} />
						<br />
						{s.kind === 'patent' ? (
							<span>
								{p.venue} ({p.details}), {p.year}.
							</span>
						) : (
							<span>
								<i>{p.venue}</i>{`${p.details ? `, ${p.details}` : ''}, ${p.year}.`}
							</span>
						)}
					</p>
				))}
			</section>
		))
	}
</BaseLayout>
