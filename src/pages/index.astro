---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const description =
	'I build high-fidelity, imaging- and physics-based models of physiological flows, ranging from digestion inside the stomach to subcutaneous injections.';

const news = (await getCollection('news'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
const fmt = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'short' });

const experience = [
	{
		dates: '2025 – present',
		org: 'Postdoctoral Research, Purdue University',
		role: 'Injectable Medicines',
		advisor: 'Arezoo Ardekani',
		blurb:
			'Building predictive models of injectable medicines — coupling poroelastic tissue mechanics with drug transport to predict systemic delivery and reduce risk in drug development.',
	},
	{
		dates: '2020 – 2025',
		org: 'Ph.D. Research, Johns Hopkins University',
		role: 'Stomach Biomechanics',
		advisor: 'Rajat Mittal',
		blurb:
			'Built imaging-based digital twins of the stomach with an immersed-boundary solver — modeling digestion, drug dissolution, reflux, and the first tool to assess pyloric surgery in gastroparesis.',
	},
	{
		dates: '2019 – 2020',
		org: 'R&D, Sterlite Technologies',
		role: 'Fiber-Optic Cable Design',
		advisor: null,
		blurb:
			'Developed theoretical and finite-element models of signal attenuation and structural response, yielding two granted U.S. patents on grooved cable and flexible ribbon designs.',
	},
	{
		dates: '2018 – 2019',
		org: "Master's Thesis, IIT Kanpur",
		role: 'Hydrodynamic Instability',
		advisor: 'Arun K. Saha',
		blurb:
			'Direct numerical simulation and linear stability analysis of flow past a square cylinder — mapping Hopf and pitchfork bifurcations under wall confinement.',
	},
	{
		dates: '2017',
		org: 'MITACS Globalink Internship, McGill University',
		role: 'Non-Newtonian Fluids',
		advisor: 'Agus P. Sasmito',
		blurb:
			'Modeled dense mine-backfill slurry as a two-phase and Bingham fluid, validated against loop tests and in-situ field data.',
	},
];

const education = [
	{
		dates: '2020 – 2025',
		school: 'Johns Hopkins University',
		degree: 'Ph.D., Mechanical Engineering',
		note: 'Dissertation: Computational fluid dynamics based models of gastric digestion in health and disease. Advisor: Rajat Mittal.',
	},
	{
		dates: '2014 – 2019',
		school: 'Indian Institute of Technology, Kanpur',
		degree: 'B.Tech–M.Tech Dual Degree, Mechanical Engineering',
		note: 'GPA 9.9/10 (B.Tech), 10/10 (M.Tech). Graduated at the top of the department. Advisor: Arun K. Saha.',
	},
];

const awards = [
	{
		year: 2025,
		name: 'Creel Family Teaching Assistant Award',
		note: 'Best teaching assistants in the department, Johns Hopkins',
		link: 'https://me.jhu.edu/news/2025-academic-award-winners-recognized-at-commencement-luncheon/',
	},
	{
		year: 2023,
		name: 'Quad Fellowship',
		note: 'Cohort of 100 STEM graduate students across Australia, India, Japan, and the USA',
		link: 'https://www.quadfellowship.org/2023-quad-fellows',
	},
	{
		year: 2019,
		name: 'General Proficiency Medal',
		note: 'Graduated at the top of the department, IIT Kanpur',
		link: 'https://www.iitk.ac.in/doaa/convocation/data/52nd-Convocation2019_Awards_and_Honours.pdf',
	},
	{
		year: 2018,
		name: 'Academic Excellence Awards',
		note: 'Also awarded in 2016 and 2015, IIT Kanpur',
		link: 'https://www.iitk.ac.in/sspc/sspc-academic-awards',
	},
	{
		year: 2017,
		name: 'O.P. Bajaj Memorial Award',
		note: 'Best final-year undergraduate in the department, IIT Kanpur',
		link: 'https://www.iitk.ac.in/sspc/sspc-academic-awards',
	},
	{
		year: 2016,
		name: 'Summer Undergraduate Research Grant for Excellence (SURGE)',
		note: 'IIT Kanpur',
		link: 'https://surge.iitk.ac.in/AnnualReport/report2016.pdf',
	},
];

const mentoring = [
	'Daira Sofia Velasco Vega — Ph.D., Purdue (2025 – )',
	'Rushikesh Prafulla Deotale — Ph.D., Purdue (2026 – )',
	'Weixuan Li — M.S., Johns Hopkins (2023 – 2025)',
	'Aditi Gupta — Undergraduate, Johns Hopkins (2023)',
];
const teaching = [
	'Numerical Methods — Johns Hopkins (2021, 2023)',
	'Computational Fluid Dynamics — Johns Hopkins (2022, 2024)',
	'Numerical Methods — IIT Kanpur (2018)',
	'Turbulent Flow — IIT Kanpur (2019)',
];
const service = [
	'Co-organizer, Mini-symposium “Computational Modeling of Physiological Flows,” SES Annual Technical Meeting, Purdue (2026)',
	'Core Team Member, Institute Counseling Service, IIT Kanpur (2016 – 2017)',
];
---

<BaseLayout title="Sharun Kuhar" description={description} permalink={Astro.site?.href} current="home">
	<header class="top">
		<img class="portrait" src={`${base}assets/portrait.jpg`} alt="Sharun Kuhar" />
		<div>
			<h1>Sharun Kuhar</h1>
			<p>Postdoctoral researcher, Purdue University</p>
			<p>
				<a href="mailto:kuhars@purdue.edu">kuhars@purdue.edu</a><br />
				<a href={`${base}assets/Sharun-Kuhar-CV.pdf`}>CV</a> ·
				<a href="https://scholar.google.com/citations?user=qHP7cqgAAAAJ">Google Scholar</a> ·
				<a href="https://www.linkedin.com/in/sharunkuhar">LinkedIn</a> ·
				<a href="https://orcid.org/0000-0001-9612-7994">ORCiD</a>
			</p>
		</div>
	</header>

	<p>
		I build high-fidelity, imaging- and physics-based models of physiological flows, ranging from
		digestion inside the stomach to subcutaneous injections.
	</p>
	<p>
		I am a postdoctoral researcher at Purdue University, modeling injectable medicines with Arezoo
		Ardekani. I earned my Ph.D. at Johns Hopkins under Rajat Mittal, where I built the first
		imaging-based digital twins of gastric flow, and my B.Tech–M.Tech at IIT Kanpur, graduating at
		the top of my department. I am a 2023 Quad Fellow, and hold two granted U.S. patents from
		earlier work in fiber optics.
	</p>

	<h2>Research</h2>
	<p>
		<a href={`${base}work/#stomach`}>Digital Twin of the Stomach</a>. An imaging data-based,
		anatomically realistic model of the stomach that captures the fluid mechanics of its contents
		alongside its physiological functions — used to study digestion, motility disorders, surgery,
		and reflux.
	</p>
	<figure class="half">
		<video autoplay muted loop playsinline poster={`${base}assets/home-flow-poster.webp`}>
			<source src={`${base}assets/home-flow.mp4`} type="video/mp4" />
		</video>
		<figcaption>Velocity field of gastric flow in the digital twin of the stomach.</figcaption>
	</figure>
	<p>
		<a href={`${base}work/#injectables`}>Injectable Medicines</a>. A mechanistic model of the
		subcutaneous administration of peptides, coupling a high-fidelity tissue-level poroelastic model
		with a systemic compartmental model to predict how an injected drug reaches the bloodstream.
	</p>
	<figure class="half">
		<img
			src={`${base}assets/work/injection-schema.webp`}
			alt="A resolved patch of interstitial tissue at the needle, coupled to plasma, peripheral tissue, and lymph."
		/>
		<figcaption>
			A resolved patch of interstitial tissue at the needle, coupled to plasma, peripheral tissue,
			and lymph.
		</figcaption>
	</figure>
	<p>Papers are listed on the <a href={`${base}publications/`}>publications</a> page.</p>

	<h2>News</h2>
	<ul class="dated">
		{
			news.map((n) => (
				<li>
					<span class="date">{fmt(n.data.pubDate)}</span>
					<a href={`${base}news/${n.id}/`}>{n.data.title}</a>
				</li>
			))
		}
	</ul>
	<p><a href={`${base}news/`}>All news</a></p>

	<h2>Experience</h2>
	{
		experience.map((e) => (
			<p>
				<b>{e.org}</b>, {e.dates}
				<br />
				{e.role}.{e.advisor && ` Advisor: ${e.advisor}.`} {e.blurb}
			</p>
		))
	}

	<h2>Education</h2>
	{
		education.map((ed) => (
			<p>
				<b>{ed.school}</b>, {ed.dates}
				<br />
				{ed.degree}. {ed.note}
			</p>
		))
	}

	<h2>Honors and awards</h2>
	<ul>
		{
			awards.map((a) => (
				<li>
					<a href={a.link}>{a.name}</a> ({a.year}). {a.note}.
				</li>
			))
		}
	</ul>

	<h2>Mentoring</h2>
	<ul>{mentoring.map((m) => <li>{m}</li>)}</ul>

	<h2>Teaching</h2>
	<ul>{teaching.map((t) => <li>{t}</li>)}</ul>

	<h2>Service</h2>
	<ul>{service.map((s) => <li>{s}</li>)}</ul>
</BaseLayout>

<style>
	.top {
		display: flex;
		gap: 24px;
		align-items: flex-start;
		margin-bottom: 28px;
	}
	.top h1 {
		margin: 0;
	}
	.top p {
		margin: 4px 0 0;
	}
	.portrait {
		width: 140px;
		height: 140px;
		object-fit: cover;
		object-position: 70% 20%;
		flex: none;
	}
	/* The home page's two research figures are smaller than elsewhere. */
	figure.half {
		width: 50%;
	}
	@media (max-width: 480px) {
		figure.half {
			width: 100%;
		}
		.top {
			flex-direction: column-reverse;
			gap: 12px;
		}
	}
</style>
