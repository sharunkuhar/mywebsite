---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Work';
const description =
	'High-fidelity computational models of physiological flow — a digital twin of the human stomach and a multiscale model of subcutaneous drug delivery — validated against clinical data.';
const permalink = `${Astro.site?.href}work`;
const base = import.meta.env.BASE_URL;

// Each pillar = a lead "model" beat + a sequence of findings. Beats alternate
// media left / right down the page; media can be a still or a looping flow video.
const stomach = {
	label: 'Ph.D. · Johns Hopkins',
	name: 'Digital Twin of the Stomach',
	lede: `The stomach lies at the center of multiple modern healthcare challenges — nutrition,
		obesity, diabetes, and drug delivery among them — and disorders such as gastroparesis and
		functional dyspepsia still have no cure. <em>In vivo</em> methods, aside from being
		resource-intensive, provide only limited access to the stomach, and <em>in vitro</em>
		methods fail to emulate its complex biomechanics. Computational approaches are well-suited
		to such problems, but although they have been used in cardiovascular flows for almost half
		a century, their use in stomach biomechanics lags cardiology by several decades.`,
	beats: [
		{
			kicker: 'The model',
			title: 'An imaging-based digital twin',
			body: 'An imaging data-based, anatomically realistic model that captures the fluid mechanics of the stomach’s contents alongside its physiological functions — the peristaltic contraction waves, the terminal antral contraction, the synchronized opening of the pylorus, and the fundic tone that drives emptying. The Navier–Stokes equations are solved inside the moving lumen with an immersed-boundary method (StomachSim).',
			media: {
				video: 'assets/home-flow.mp4',
				poster: 'assets/home-flow-poster.webp',
				cap: 'Velocity field of gastric flow — the retropulsive and pyloric jets driven by peristalsis.',
			},
		},
		{
			year: '2022',
			kicker: 'Physics of Fluids',
			title: 'Motility disorders slow digestion — not just emptying',
			body: 'Modeling the hydrolysis of a liquid protein meal — enzyme secretion from the proximal walls and the consequent catalytic breakdown of proteins — reveals that motility disorders not only slow the gastric emptying rate but also reduce the rate of hydrolysis of the meal. The emptying rate varies linearly with motility, but the mixing of the contents and the sites of chemical hydrolysis show a non-linear response.',
			media: {
				video: 'assets/work/hydrolysis-flow.mp4',
				poster: 'assets/work/hydrolysis-flow-poster.webp',
				cap: 'Iso-surfaces of enzyme (pepsin) and hydrolyzed-protein concentration evolving over an hour of digestion.',
			},
			paper: 'Effect of stomach motility on food hydrolysis and gastric emptying',
			doi: 'https://doi.org/10.1063/5.0120933',
		},
		{
			year: '2024',
			kicker: 'J. R. Soc. Interface',
			title: 'Why the same surgery helps some gastroparesis patients and not others',
			body: 'Two phenotypes of gastroparesis — antral hypomotility and decreased gastric tone — present with similar reductions in gastric emptying, yet respond very differently to pyloroplasty, which enlarges the pylorus and disrupts its sphincter function. The procedure helps only if the stomach retains some of its gastric tone; where tone is lost, enlarging the orifice does not improve emptying but reduces it further, because of the increased reflux from the duodenum into the stomach — a possible explanation for the uneven response of patients to these procedures.',
			media: {
				img: 'assets/work/surgery-flowrate.webp',
				cap: 'Pyloric flow over one contraction cycle. After surgery the hypomotility case (red) recovers; the decreased-tone case (green) develops a large backflow — reflux into the stomach.',
			},
			paper:
				'In-silico modelling of the effect of pyloric intervention procedures on gastric flow and emptying in a stomach with gastroparesis',
			doi: 'https://doi.org/10.1098/rsif.2023.0567',
		},
		{
			year: '2025',
			kicker: 'Am. J. Physiol.-GI',
			title: 'A mechanism for bile reflux — and why meal density matters',
			body: 'When the pylorus cannot close, duodenal contents reflux back into the stomach — a cause of bile reflux gastritis and, when it reaches the esophagus, associated with Barrett’s esophagus. In the model, the reflux is driven by the relaxation of the stomach walls next to a patent pylorus right after the terminal antral contraction. Even small differences in the density of the gastric contents relative to bile change which walls are exposed: heavier contents expose a much larger region along the lesser curvature and accumulate near the esophageal sphincter, so a layer of low-density fat floating on top could keep the reflux from reaching the esophagus.',
			media: {
				video: 'assets/work/reflux-flow.mp4',
				poster: 'assets/work/reflux-flow-poster.webp',
				cap: 'Duodenal contents (bile, green) refluxing into the stomach through an incompetent pylorus after the terminal antral contraction.',
			},
			paper: 'Duodenogastric reflux in health and disease',
			doi: 'https://doi.org/10.1152/ajpgi.00241.2024',
		},
		{
			year: '2025',
			kicker: 'J. R. Soc. Interface',
			title: 'The first stomach model that grinds solid food',
			body: 'Existing computational models of the stomach sidestep the complexity of solid food by assuming the contents are purely liquid — yet a real meal contains particles too large to pass the pyloric sieve, which must first undergo physical breakdown in the antrum, a phenomenon called trituration. This first-of-its-kind model resolves large solid particles in the flow and captures the repeated cycle of propulsion, grinding, and retropulsion. Weaker contractions impair the stomach’s ability to trap particles in the terminal antrum before retropulsion; in the hypomotility case, many never reach it at all.',
			media: {
				video: 'assets/work/solidfood-flow.mp4',
				poster: 'assets/work/solidfood-flow-poster.webp',
				cap: 'Velocity iso-surfaces around large solid food particles settling and shuttling in the antrum.',
			},
			paper: 'In-silico study of the forces causing solid-food breakdown inside the stomach',
			doi: 'https://doi.org/10.1098/rsif.2025.0291',
		},
	],
};

const injectables = {
	label: 'Postdoctoral · Purdue',
	name: 'Injectable Medicines',
	lede: `Subcutaneous injection is the preferred route for delivering peptides — including GLP-1
		drugs such as semaglutide and liraglutide — but their delivery and pharmacokinetics are
		complex, with multiple competing effects at diverse spatial and temporal scales.
		Compartmental models represent the injection site as a single well-mixed depot;
		high-fidelity tissue-level models resolve the plume but only for a short duration, and only
		for monoclonal antibodies. No such model exists for peptides, whose concentration-dependent
		oligomerization and reversible binding to serum albumin and the extracellular matrix have
		not been captured.`,
	beats: [
		{
			kicker: 'The model',
			title: 'A multiscale coupling',
			body: 'A high-fidelity tissue-level poroelastic simulation coupled with a systemic compartmental pharmacokinetic model — a tri-compartmental representation of plasma, lymphatics, and peripheral tissue — using flexible time-stepping to enable multi-day predictions without compromising local resolution.',
			media: {
				img: 'assets/work/injection-schema.webp',
				cap: 'A resolved patch of interstitial tissue at the needle, coupled to plasma, peripheral tissue, and lymph.',
			},
		},
		{
			kicker: 'Five species',
			title: 'A drug that is never one thing at a time',
			body: 'Besides undergoing oligomerization, the peptide in the depot binds reversibly with serum albumin infiltrating from the surrounding tissue and attaches to binding sites in the extracellular matrix; these reactions alter its effective size and mobility, and thus its rate of absorption into blood and lymphatics. The model tracks five species: monomers, oligomers, albumin, albumin-bound monomers, and ECM-bound monomers.',
			media: {
				img: 'assets/work/injection-reactions.webp',
				cap: 'The reaction network: monomer ⇌ oligomer, with reversible albumin- and ECM-binding.',
			},
		},
		{
			kicker: 'Validation',
			title: 'Matched to the clinic for two GLP-1 peptides',
			body: 'Applied to two peptides, semaglutide and liraglutide, over clinically relevant durations of multiple days — while also capturing the small-time-scale phenomena that occur during and soon after injection — the predicted plasma-concentration profiles show good agreement with clinical data.',
			media: {
				img: 'assets/work/injection-validation.webp',
				cap: 'Predicted plasma concentration versus published clinical data.',
			},
			paper: 'Multiscale modeling of the subcutaneous administration of peptides',
			doi: 'https://doi.org/10.64898/2026.06.01.724102',
		},
		{
			kicker: 'Mechanism',
			title: 'Albumin binding is the hidden lever on uptake',
			body: 'The model reveals novel mechanisms — among them, albumin-bound monomers forming an envelope around the plume in the minutes following injection. In a parametric study, albumin binding emerged as the most dominant factor: any hindrance in it led to a sharp decline in the rate of uptake and bioavailability, as it serves as the primary vehicle for delivering peptides into plasma.',
			media: {
				img: 'assets/work/injection-concentration.webp',
				cap: 'Concentration of monomer, oligomer, albumin, and albumin-bound peptide around the needle.',
			},
		},
	],
};

const pillars = [
	{ id: 'stomach', ...stomach },
	{ id: 'injectables', ...injectables },
];

const earlier = [
	{
		years: '2019 – 2020',
		name: 'Fiber-optic cable design',
		blurb:
			'Theoretical and semi-empirical models of signal attenuation under crush force and winding tension, leading to two granted U.S. patents — a grooved air-blown cable and a flexible bonded ribbon.',
	},
	{
		years: '2018 – 2019',
		name: 'Hydrodynamic instability',
		blurb:
			'Direct numerical simulation and linear stability analysis of flow past a square cylinder in a channel, mapping the onset of unsteadiness across blockage ratios.',
	},
	{
		years: '2017 – 2018',
		name: 'Non-Newtonian flows',
		blurb:
			'Pressure-loss and friction-factor modeling of dense mine-paste backfill slurry (40–70% solids), validated against loop tests and mine field data.',
	},
];
---

<BaseLayout title={title} description={description} permalink={permalink} current="work" bleed={true}>
	<section class="intro">
		<div class="wrap">
			<div class="eyebrow">
				<span class="rule"></span>
				<span class="kicker">Research</span>
			</div>
			<h1>Computational models of the human body.</h1>
			<p class="intro-lede">
				I build high-fidelity, imaging- and physics-based models of physiological flows, ranging from
				digestion inside the stomach to subcutaneous injections. Each model is compared against
				clinical data wherever possible and captures patient characteristics, measurements of which
				are invasive, expensive, or out of reach.
			</p>
			<nav class="jump">
				{pillars.map((p) => <a href={`#${p.id}`}>{p.name}</a>)}
			</nav>
		</div>
	</section>

	{
		pillars.map((p) => (
			<section class="pillar" id={p.id}>
				<div class="wrap">
					<header class="pillar-head">
						<span class="label">{p.label}</span>
						<h2>{p.name}</h2>
						<p class="pillar-lede" set:html={p.lede} />
					</header>

					<div class="beats">
						{p.beats.map((b, i) => (
							<article class={i % 2 === 0 ? 'beat flip' : 'beat'}>
								<div class="beat-copy">
									<span class="meta">
										{b.year && <span class="yr">{b.year}</span>}
										{b.kicker}
									</span>
									<h3>{b.title}</h3>
									<p>{b.body}</p>
									{b.doi && (
										<a class="doi" href={b.doi} target="_blank" rel="noopener">
											{b.paper} &nbsp;<span class="arr">&rarr;</span>
										</a>
									)}
								</div>
								<figure class="beat-fig">
									<div class={b.media.video ? 'frame video' : 'frame'}>
										{b.media.video ? (
											<video autoplay muted loop playsinline poster={`${base}${b.media.poster}`}>
												<source src={`${base}${b.media.video}`} type="video/mp4" />
											</video>
										) : (
											<img src={`${base}${b.media.img}`} alt={b.media.cap} loading="lazy" />
										)}
									</div>
									<figcaption>{b.media.cap}</figcaption>
								</figure>
							</article>
						))}
					</div>

					<a class="all" href={`${base}publications/`}>
						All publications &rarr;
					</a>
				</div>
			</section>
		))
	}

	<section class="earlier">
		<div class="wrap">
			<span class="label">Before the body</span>
			<h2 class="earlier-title">Earlier work</h2>
			<div class="earlier-grid">
				{
					earlier.map((e) => (
						<div class="earlier-item">
							<span class="e-years">{e.years}</span>
							<h3>{e.name}</h3>
							<p>{e.blurb}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 var(--sp-6);
		width: 100%;
		box-sizing: border-box;
	}

	/* ---------- intro ---------- */
	.intro {
		padding: var(--sp-9) 0 var(--sp-7);
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: var(--sp-4);
	}

	.rule {
		height: 1px;
		width: 42px;
		background: var(--flow);
		opacity: 0.6;
	}

	.kicker {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: 1.15rem;
		color: var(--flow);
	}

	.intro h1 {
		font-size: var(--fs-2xl);
		margin: 0 0 var(--sp-4);
	}

	.intro-lede {
		font-size: var(--fs-md);
		line-height: 1.65;
		color: var(--muted);
		margin: 0 0 var(--sp-6);
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
	}

	.jump a {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--flow);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 7px 16px;
		transition: all 0.18s ease;
	}

	.jump a:hover {
		border-color: var(--flow);
		background: color-mix(in srgb, var(--flow) 8%, transparent);
	}

	/* ---------- labels ---------- */
	.label {
		font-family: var(--font-text);
		font-size: var(--fs-label);
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--muted);
		display: block;
	}

	/* ---------- pillar ---------- */
	.pillar {
		padding: var(--sp-9) 0;
		border-bottom: 1px solid var(--line);
		scroll-margin-top: 80px;
	}

	.pillar-head {
		margin-bottom: var(--sp-8);
	}

	.pillar-head h2 {
		font-size: var(--fs-2xl);
		margin: 10px 0 var(--sp-4);
	}

	.pillar-lede {
		font-size: var(--fs-md);
		line-height: 1.65;
		margin: 0;
		color: var(--muted);
	}

	.pillar-lede em {
		font-style: italic;
		color: var(--ink);
	}

	/* ---------- framed figures (native white bg, no forced ratio) ---------- */
	.frame {
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: radial-gradient(
			120% 120% at 50% 0%,
			color-mix(in srgb, var(--flow) 7%, var(--surface)),
			var(--surface)
		);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--sp-5);
	}

	.frame img {
		width: 100%;
		height: auto;
		display: block;
		mix-blend-mode: multiply;
	}

	:global(.theme-dark) .frame img {
		mix-blend-mode: normal;
	}

	.frame.video {
		padding: 0;
	}

	.frame.video video {
		width: 100%;
		height: auto;
		display: block;
	}

	figure {
		margin: 0;
	}

	figcaption {
		margin-top: 12px;
		font-size: 0.85rem;
		color: var(--muted);
		line-height: 1.5;
	}

	/* ---------- beats (alternating rows) ---------- */
	.beats {
		display: flex;
		flex-direction: column;
		gap: var(--sp-8);
	}

	.beat {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--sp-7);
		align-items: center;
	}

	.beat.flip .beat-copy {
		order: 2;
	}

	.beat-copy .meta {
		font-size: var(--fs-label);
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--muted);
		display: inline-flex;
		align-items: baseline;
		gap: 10px;
	}

	.beat-copy .yr {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 500;
		letter-spacing: 0;
		text-transform: none;
		font-size: 1.15rem;
		color: var(--flow);
	}

	.beat-copy h3 {
		font-size: var(--fs-lg);
		line-height: 1.2;
		margin: var(--sp-3) 0 var(--sp-3);
	}

	.beat-copy p {
		margin: 0 0 var(--sp-4);
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.doi {
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
		text-decoration: none;
		display: inline-block;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
		transition:
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.doi .arr {
		color: var(--flow);
	}

	.doi:hover {
		color: var(--flow);
		border-color: var(--flow);
	}

	/* ---------- all-publications link ---------- */
	.all {
		display: inline-block;
		margin-top: var(--sp-8);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--flow);
		text-decoration: none;
	}

	.all:hover {
		text-decoration: underline;
	}

	/* ---------- earlier ---------- */
	.earlier {
		padding: var(--sp-9) 0;
	}

	.earlier-title {
		font-size: var(--fs-xl);
		margin: 10px 0 var(--sp-7);
	}

	.earlier-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--sp-6);
	}

	.e-years {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		color: var(--flow);
	}

	.earlier-item h3 {
		font-size: var(--fs-md);
		margin: var(--sp-2) 0 var(--sp-3);
	}

	.earlier-item p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted);
	}

	@media (max-width: 820px) {
		.beat {
			grid-template-columns: 1fr;
			gap: var(--sp-4);
		}
		.beat.flip .beat-copy {
			order: 0;
		}
		.beat-fig {
			order: -1;
		}
		.earlier-grid {
			grid-template-columns: 1fr;
			gap: var(--sp-7);
		}
	}
</style>
