---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';

export async function getStaticPaths() {
	const posts = await getCollection('news');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

type Props = { post: CollectionEntry<'news'> };

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const readingTimeEstimate = readingTime(post.body ?? '').text;
const permalink = `${Astro.site?.href}news/${post.id}/`;
const { Content } = await render(post);
const formattedDate = new Date(pubDate).toLocaleDateString('en-us', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<BaseLayout title={`${title} — Sharun Kuhar`} description={description} permalink={permalink} current="news">
	<h1>{title}</h1>
	<p class="muted">{formattedDate} · {readingTimeEstimate}</p>
	<article>
		<Content />
	</article>
	<Bio />
</BaseLayout>
