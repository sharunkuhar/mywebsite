---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About — Sharun Kuhar';
const description =
	'Sharun Kuhar builds physics-based simulations of the human body and turns them into tools for medicine. Postdoc at Purdue, Ph.D. from Johns Hopkins, B.Tech–M.Tech from IIT Kanpur, Quad Fellow.';
const permalink = `${Astro.site?.href}about`;
const base = import.meta.env.BASE_URL;

const experience = [
	{
		role: 'Injectable Medicines',
		org: 'Postdoctoral Research, Purdue University',
		advisor: 'Arezoo Ardekani',
		dates: '2025 — Present',
		blurb:
			'Building predictive models of injectable medicines — coupling poroelastic tissue mechanics with drug transport to predict systemic delivery and reduce risk in drug development.',
	},
	{
		role: 'Stomach Biomechanics',
		org: 'Ph.D. Research, Johns Hopkins University',
		advisor: 'Rajat Mittal',
		dates: '2020 — 2025',
		blurb:
			'Built imaging-based digital twins of the stomach with an immersed-boundary solver — modeling digestion, drug dissolution, reflux, and the first tool to assess pyloric surgery in gastroparesis.',
	},
	{
		role: 'Fiber-Optic Cable Design',
		org: 'R&D, Sterlite Technologies',
		advisor: null,
		dates: '2019 — 2020',
		blurb:
			'Developed theoretical and finite-element models of signal attenuation and structural response, yielding two granted U.S. patents on grooved cable and flexible ribbon designs.',
	},
	{
		role: 'Hydrodynamic Instability',
		org: "Master's Thesis, IIT Kanpur",
		advisor: 'Arun K. Saha',
		dates: '2018 — 2019',
		blurb:
			'Direct numerical simulation and linear stability analysis of flow past a square cylinder — mapping Hopf and pitchfork bifurcations under wall confinement.',
	},
	{
		role: 'Non-Newtonian Fluids',
		org: 'MITACS Globalink Internship, McGill University',
		advisor: 'Agus P. Sasmito',
		dates: '2017',
		blurb:
			'Modeled dense mine-backfill slurry as a two-phase and Bingham fluid, validated against loop tests and in-situ field data.',
	},
];

const education = [
	{
		school: 'Johns Hopkins University',
		degree: 'Ph.D., Mechanical Engineering',
		place: 'Baltimore, MD',
		dates: '2020 — 2025',
		note: 'Dissertation: Computational fluid dynamics based models of gastric digestion in health and disease. Advisor: Rajat Mittal.',
	},
	{
		school: 'Indian Institute of Technology, Kanpur',
		degree: 'B.Tech–M.Tech Dual Degree, Mechanical Engineering',
		place: 'Kanpur, India',
		dates: '2014 — 2019',
		note: 'GPA 9.9/10 (B.Tech), 10/10 (M.Tech). Graduated at the top of the department. Advisor: Arun K. Saha.',
	},
];

const awards = [
	{
		year: 2025,
		name: 'Creel Family Teaching Assistant Award',
		note: 'Best teaching assistants in the department, Johns Hopkins',
		link: 'https://me.jhu.edu/news/2025-academic-award-winners-recognized-at-commencement-luncheon/',
	},
	{
		year: 2023,
		name: 'Quad Fellowship',
		note: 'Cohort of 100 STEM graduate students across Australia, India, Japan, and the USA',
		link: 'https://www.quadfellowship.org/2023-quad-fellows',
	},
	{
		year: 2019,
		name: 'General Proficiency Medal',
		note: 'Graduated at the top of the department, IIT Kanpur',
		link: 'https://www.iitk.ac.in/doaa/convocation/data/52nd-Convocation2019_Awards_and_Honours.pdf',
	},
	{
		year: 2017,
		name: 'O.P. Bajaj Memorial Award',
		note: 'Best final-year undergraduate in the department, IIT Kanpur',
		link: 'https://www.iitk.ac.in/sspc/sspc-academic-awards',
	},
	{
		year: 2018,
		name: 'Academic Excellence Awards',
		note: 'Also awarded in 2016 and 2015, IIT Kanpur',
		link: 'https://www.iitk.ac.in/sspc/sspc-academic-awards',
	},
	{
		year: 2016,
		name: 'Summer Undergraduate Research Grant for Excellence (SURGE)',
		note: 'IIT Kanpur',
		link: 'https://surge.iitk.ac.in/AnnualReport/report2016.pdf',
	},
];

const mentoring = [
	'Daira Sofia Velasco Vega — Ph.D., Purdue (2025 – )',
	'Rushikesh Prafulla Deotale — Ph.D., Purdue (2026 – )',
	'Weixuan Li — M.S., Johns Hopkins (2023 – 2025)',
	'Aditi Gupta — Undergraduate, Johns Hopkins (2023)',
];

const teaching = [
	'Numerical Methods — Johns Hopkins (2021, 2023)',
	'Computational Fluid Dynamics — Johns Hopkins (2022, 2024)',
	'Numerical Methods — IIT Kanpur (2018)',
	'Turbulent Flow — IIT Kanpur (2019)',
];

const service = [
	'Co-organizer, Mini-symposium “Computational Modeling of Physiological Flows,” SES Annual Technical Meeting, Purdue (2026)',
	'Core Team Member, Institute Counseling Service, IIT Kanpur (2016 – 2017)',
];
---

<BaseLayout title={title} description={description} permalink={permalink} current="about" bleed={true}>
	<section class="intro">
		<div class="wrap intro-grid">
			<div class="intro-copy">
				<div class="eyebrow">
					<span class="rule"></span>
					<span class="kicker">About</span>
				</div>
				<h1>Physics into medicine.</h1>
				<p>
					Sharun Kuhar is a computational scientist working at the boundary of fluid mechanics and
					medicine. He builds physics-based simulations of the human body — the stomach as it digests,
					tissue as it absorbs an injected drug — and turns them into tools that clinicians and drug
					developers can act on.
				</p>
				<p>
					He is a postdoctoral researcher at Purdue University, modeling injectable medicines with
					Arezoo Ardekani. He earned his Ph.D. at Johns Hopkins under Rajat Mittal, where he built the
					first imaging-based digital twins of gastric flow, and his B.Tech–M.Tech at IIT Kanpur,
					graduating at the top of his department. He is a 2023 Quad Fellow, and holds two granted U.S.
					patents from earlier work in fiber optics.
				</p>
				<div class="actions">
					<a class="btn primary" href={`${base}assets/Sharun-Kuhar-CV.pdf`}>Download CV</a>
					<a class="btn ghost" href={`${base}contact/`}>Get in touch</a>
				</div>
			</div>
			<div class="portrait-card">
				<img src={`${base}assets/portrait.jpg`} alt="Sharun Kuhar" />
			</div>
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<span class="label">Experience</span>
			<ol class="timeline">
				{
					experience.map((e) => (
						<li class="tl-item">
							<span class="tl-dates">{e.dates}</span>
							<div class="tl-body">
								<h3>{e.role}</h3>
								<p class="tl-org">
									{e.org}
									{e.advisor && <span class="tl-adv"> · Advisor: {e.advisor}</span>}
								</p>
								<p class="tl-blurb">{e.blurb}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="block alt">
		<div class="wrap">
			<span class="label">Education</span>
			<div class="edu-grid">
				{
					education.map((ed) => (
						<div class="edu">
							<span class="tl-dates">{ed.dates}</span>
							<h3>{ed.school}</h3>
							<p class="edu-degree">
								{ed.degree} · {ed.place}
							</p>
							<p class="tl-blurb">{ed.note}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<span class="label">Honors &amp; awards</span>
			<ul class="awards">
				{
					awards.map((a) => (
						<li>
							<span class="pub-year">{a.year}</span>
							<div>
								{a.link ? (
									<a class="aw-name" href={a.link} target="_blank" rel="noopener">
										{a.name}
									</a>
								) : (
									<span class="aw-name">{a.name}</span>
								)}
								<span class="aw-note">{a.note}</span>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="block alt">
		<div class="wrap threecol">
			<div>
				<span class="label">Mentoring</span>
				<ul class="plain">{mentoring.map((m) => <li>{m}</li>)}</ul>
			</div>
			<div>
				<span class="label">Teaching</span>
				<ul class="plain">{teaching.map((t) => <li>{t}</li>)}</ul>
			</div>
			<div>
				<span class="label">Service &amp; outreach</span>
				<ul class="plain">{service.map((s) => <li>{s}</li>)}</ul>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 var(--sp-6);
		width: 100%;
		box-sizing: border-box;
	}

	.label {
		font-family: var(--font-text);
		font-size: var(--fs-label);
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--muted);
		display: block;
		margin-bottom: var(--sp-5);
	}

	.tl-dates {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--flow);
		font-variant-numeric: tabular-nums;
	}

	/* ---------- intro ---------- */
	.intro {
		padding: var(--sp-9) 0;
		border-bottom: 1px solid var(--line);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 1.4fr 0.6fr;
		gap: var(--sp-8);
		align-items: start;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: var(--sp-4);
	}

	.rule {
		height: 1px;
		width: 42px;
		background: var(--flow);
		opacity: 0.6;
	}

	.kicker {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: 1.15rem;
		color: var(--flow);
	}

	.intro-copy h1 {
		font-size: var(--fs-2xl);
		margin: 0 0 var(--sp-5);
	}

	.intro-copy p {
		font-size: 1.1rem;
		line-height: 1.7;
		margin: 0 0 var(--sp-4);
		max-width: 60ch;
	}

	.actions {
		display: flex;
		gap: var(--sp-3);
		flex-wrap: wrap;
		margin-top: var(--sp-6);
	}

	.btn {
		font-family: var(--font-text);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 12px 20px;
		border-radius: 9px;
		transition: all 0.18s ease;
	}

	.btn.primary {
		background: var(--flow);
		color: #fff;
	}

	.btn.primary:hover {
		filter: brightness(1.08);
	}

	.btn.ghost {
		border: 1px solid var(--line);
		color: var(--ink);
	}

	.btn.ghost:hover {
		border-color: var(--flow);
		color: var(--flow);
	}

	.portrait-card {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 12px;
		background: var(--surface);
	}

	.portrait-card img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
	}

	/* ---------- blocks ---------- */
	.block {
		padding: var(--sp-9) 0;
		border-bottom: 1px solid var(--line);
	}

	.block.alt {
		background: color-mix(in srgb, var(--flow) 3%, var(--bg));
	}

	/* timeline */
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid var(--line);
	}

	.tl-item {
		position: relative;
		padding: 0 0 var(--sp-7) var(--sp-6);
		margin: 0;
	}

	.tl-item:last-child {
		padding-bottom: 0;
	}

	.tl-item::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 4px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--flow);
		border: 2px solid var(--bg);
	}

	.tl-body h3 {
		font-size: var(--fs-lg);
		margin: 6px 0 4px;
	}

	.tl-org {
		font-size: 0.95rem;
		color: var(--ink);
		margin: 0 0 6px;
	}

	.tl-adv {
		color: var(--muted);
	}

	.tl-blurb {
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
		max-width: 68ch;
	}

	/* education */
	.edu-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--sp-6);
	}

	.edu {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: var(--sp-6);
	}

	.edu h3 {
		font-size: var(--fs-md);
		margin: 8px 0 4px;
	}

	.edu-degree {
		font-size: 0.92rem;
		color: var(--ink);
		margin: 0 0 8px;
	}

	/* awards */
	.awards {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.awards li {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
	}

	.pub-year {
		flex-shrink: 0;
		min-width: 3rem;
		font-size: 0.85rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.aw-name {
		display: block;
		font-weight: 600;
		font-size: 1rem;
		color: var(--ink);
		text-decoration: none;
	}

	a.aw-name:hover {
		color: var(--flow);
	}

	.aw-note {
		font-size: 0.85rem;
		color: var(--muted);
	}

	/* three columns */
	.threecol {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--sp-7);
	}

	.plain {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.plain li {
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
		padding: 8px 0;
		border-top: 1px solid var(--line);
	}

	.plain li:first-child {
		border-top: none;
	}

	@media (max-width: 820px) {
		.intro-grid {
			grid-template-columns: 1fr;
		}
		.portrait-card {
			max-width: 260px;
			order: -1;
		}
		.edu-grid,
		.threecol {
			grid-template-columns: 1fr;
			gap: var(--sp-6);
		}
	}
</style>
